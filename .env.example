# Copy to .env for local development: cp .env.example .env
# .env is never committed (.gitignore). Production values live in Vercel.

# The local Postgres from docker-compose.yml. Port 5433, not 5432 (see the
# comment there). Never put a production URL here: the guarded commands
# refuse it, but the others (db:migrate, db:studio, npm run dev) would use it.
DATABASE_URL=postgres://home_base:home_base@localhost:5433/home_base
